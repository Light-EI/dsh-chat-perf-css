{
  "name": "dsh-chat-perf-css",
  "version": "1.0.3",
  "private": true,
  "description": "Long-conversation render relief for the DSH chat view: off-screen message bodies and block formulas skip style, layout and paint.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "content-visibility",
    "long-conversation",
    "rendering",
    "performance"
  ],
  "homepage": "https://github.com/Light-EI/dsh-chat-perf-css#readme",
  "bugs": {
    "url": "https://github.com/Light-EI/dsh-chat-perf-css/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Light-EI/dsh-chat-perf-css.git"
  },
  "license": "MIT",
  "author": "Light-EI",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "manifestVersion": 1
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  }
}
